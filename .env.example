# Copy to .env and fill in. Never commit .env.

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Models (check current model IDs in the Anthropic docs)
VERIGRAD_EXTRACT_MODEL=
VERIGRAD_COMPARE_MODEL=

# Cost guard: abort extraction for one programme above this spend (USD)
VERIGRAD_MAX_COST_PER_PROGRAM=0.30

# Local storage
VERIGRAD_DATA_DIR=./data
VERIGRAD_DB_PATH=./data/verigrad.db

# Fetching
VERIGRAD_FETCH_DELAY_SECONDS=3
VERIGRAD_FETCH_TIMEOUT_SECONDS=45

# Display timezone
VERIGRAD_TIMEZONE=Asia/Karachi

# Copy to .env and fill in. Never commit .env.

# Anthropic API key (console.anthropic.com). The app starts without it;
# only Claude calls need it.
ANTHROPIC_API_KEY=

# Models (must be in the price table: core/llm/pricing.py)
VERIGRAD_EXTRACT_MODEL=claude-sonnet-5-5
VERIGRAD_COMPARE_MODEL=claude-haiku-4-5

# Cost guard: abort one extraction/eval job above this spend (USD)
VERIGRAD_MAX_COST_PER_JOB=0.30

# Claude request timeout (seconds, per attempt)
VERIGRAD_LLM_TIMEOUT_SECONDS=120

# Local storage
VERIGRAD_DATA_DIR=./data
VERIGRAD_DB_PATH=./data/verigrad.db

# Fetching
VERIGRAD_FETCH_DELAY_SECONDS=3
VERIGRAD_FETCH_TIMEOUT_SECONDS=45
# Browser: empty = Playwright's bundled Chromium (`uv run playwright install chromium`).
# Set to msedge or chrome to use an installed browser if that download is blocked.
VERIGRAD_BROWSER_CHANNEL=

# Display timezone
VERIGRAD_TIMEZONE=Asia/Karachi
